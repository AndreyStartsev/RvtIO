<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime dependencies of the library. See docs/dependencies.md for the reasons behind each version. -->
    <PackageVersion Include="OpenMcdf" Version="3.4.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scene contract of RvtIO.Scene: any patch of the 0.1 line, never a preview of the next (breaking) minor. -->
    <PackageVersion Include="IOScene" Version="[0.1.0, 0.2.0-0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only packages, pinned to exact versions (no floating ranges). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
