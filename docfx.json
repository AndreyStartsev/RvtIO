{
  "metadata": [
    {
      "src": [
        { "src": "src/RvtIO", "files": ["RvtIO.csproj"] },
        { "src": "src/RvtIO.Scene", "files": ["RvtIO.Scene.csproj"] }
      ],
      "dest": "docs/api",
      "properties": { "TargetFramework": "net10.0", "TargetFrameworks": "net10.0" },
      "outputFormat": "apiPage"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["*.md", "toc.yml", "api/**/*.yml", "api/**/*.md"] }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "RvtIO",
      "_appFooter": "RvtIO is licensed under the MIT License. Not affiliated with Autodesk.",
      "_enableSearch": true
    },
    "template": ["default", "modern"]
  }
}
