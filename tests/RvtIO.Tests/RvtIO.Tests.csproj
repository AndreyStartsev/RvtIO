<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>RvtIO.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="OpenMcdf" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RvtIO\RvtIO.csproj" />
    <!-- The command line tool, run through its entry point by CliExitCodeTests. -->
    <ProjectReference Include="..\..\src\RvtIO.Cli\RvtIO.Cli.csproj" />
    <!-- The scene adapter, whose mapping tests run on synthetic meshes. -->
    <ProjectReference Include="..\..\src\RvtIO.Scene\RvtIO.Scene.csproj" />
    <!-- Compile the research decoder itself: no copied test implementation or CLI dependency. -->
    <Compile Include="..\..\tools\RootProbe\HistoryBoundaryProbe.cs" Link="RootProbe\HistoryBoundaryProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\StairBoundaryProbe.cs" Link="RootProbe\StairBoundaryProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\UnitOptionsProbe.cs" Link="RootProbe\UnitOptionsProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\ExactStreamProbe.cs" Link="RootProbe\ExactStreamProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\DeferredFieldProbe.cs" Link="RootProbe\DeferredFieldProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\ParameterInputProbe.cs" Link="RootProbe\ParameterInputProbe.cs" />
    <!-- The command line option parser of the CLI, compiled here to test it without starting the tool. -->
    <Compile Include="..\..\src\RvtIO.Cli\JsonClassPrefixOption.cs" Link="Cli\JsonClassPrefixOption.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\IfcTimestampOption.cs" Link="Cli\IfcTimestampOption.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\OpeningAxesOption.cs" Link="Cli\OpeningAxesOption.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\CurrentCopiesOption.cs" Link="Cli\CurrentCopiesOption.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\ReportPathOption.cs" Link="Cli\ReportPathOption.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\DowngradeCommand.cs" Link="Cli\DowngradeCommand.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\SaveAsCommand.cs" Link="Cli\SaveAsCommand.cs" />
    <Compile Include="..\..\src\RvtIO.Cli\CoverageCommand.cs" Link="Cli\CoverageCommand.cs" />
  </ItemGroup>

</Project>
